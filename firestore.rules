rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'bajaojoshua2@gmail.com';
    }

    function isValidInquiry() {
      return request.resource.data.keys().hasOnly([
          'name',
          'email',
          'subject',
          'message',
          'status',
          'source',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 2
        && request.resource.data.subject.size() <= 160
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 3000
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'portfolio'
        && request.resource.data.createdAt == request.time;
    }

    match /inquiries/{inquiryId} {
      allow create: if isValidInquiry();
      allow read: if isOwner();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isOwner();
    }
  }
}